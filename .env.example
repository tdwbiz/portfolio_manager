# Example environment configuration — copy to .env and fill in real values.
# Never commit .env.

# RBC account configuration: comma-separated list of "id:label" pairs.
RBC_ACCOUNTS=90000001:ACCOUNT_A,90000002:ACCOUNT_B,90000003:ACCOUNT_C,90000004:ACCOUNT_D,90000005:ACCOUNT_E,90000006:ACCOUNT_F,90000007:ACCOUNT_G,90000008:ACCOUNT_H

# Default RBC account used by scripts that accept --account.
RBC_DEFAULT_ACCOUNT=90000001
