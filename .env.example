# Example environment configuration — copy to .env and fill in real values.
# Never commit .env.

# Key for account fingerprints (HMAC-SHA256 of normalised account numbers).
# Generate a random value of at least 32 characters and store a copy in your
# password manager. Never put a real key in this file.
ACCOUNT_FINGERPRINT_KEY=

# VL (vision) model for PDF statement parsing — OpenAI-compatible endpoint.
# All lines optional: unset means the code default (Halogen on saturn Ubuntu)
# is used. Uncomment and change only to override.
# VL_MODEL_BASE_URL=http://127.0.0.1:11435/v1
# VL_MODEL_NAME=halogen-qwen3.8-flash-next
# VL_MODEL_API_KEY=not-used
# VL_MAX_TOKENS=16384
# VL_TEMPERATURE=0.1
