{
  "languages": {
    "Python": {
      "language_servers": ["pyright", "ruff", "default"]
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "pyright.disableCustomTypeVars": false,
        "python.analysis": {
          "autoImportCompletions": true,
          "autoSearchPaths": true,
          "extraPaths": [
            "/opt/pm-venv/lib/python3.14/site-packages"
          ],
          "typeCheckingMode": "basic",
          "stubPath": "typings"
        }
      }
    }
  }
}
